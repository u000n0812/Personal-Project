# Postgres 연결 주소
# Vercel에 배포하면 Storage에서 Postgres를 붙일 때 자동으로 채워져요.
# 로컬에서는 직접 띄운 Postgres나 Neon 무료 브랜치 주소를 넣으면 돼요.
DATABASE_URL="postgresql://user:password@localhost:5432/monblanc?schema=public"

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급하는 무료 Gemini API 키
GEMINI_API_KEY="your-gemini-api-key"
